rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    // ✅ Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ✅ Check if user is active (not suspended)
    function isActive() {
      return isAuthenticated() && 
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         !('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active');
    }
    
    // ✅ Check if user is admin
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    // ✅ Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ✅ Check if user is organizer
    function isOrganizer() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "organizer";
    }

    // ✅ NEW — Check if user is an appointed campus ambassador
    function isCampusAmbassador() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCampusAmbassador == true;
    }
    
    
    // ==========================================
    // USERS COLLECTION - WITH REFERRAL SUPPORT
    // ==========================================
    match /users/{userId} {
      // ✅ Anyone can list/search users (needed for referral code lookup)
      allow list: if true;
      
      // ✅ Anyone can read user profiles (needed for referral system)
      allow get: if true;
      
      // ✅ Users can create their OWN user document during signup
      allow create: if isAuthenticated() && 
        request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user');
      
      // ✅ Users can update their own profile
      // ✅ BUT cannot change role, status, isAmbassador, or ambassadorSince
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 
          'status', 
          'isAmbassador', 
          'ambassadorSince',
          'creditsUnlocked',  // ✅ NEW — prevent users self-unlocking credits
          'isCampusAmbassador',  // ✅ NEW — prevent users self-promoting to campus ambassador
          'assignedCampuses'  // ✅ NEW — prevent users self-assigning campuses
        ]) ||
        // ✅ Allow webhook to update credits (credits can only decrease or stay same)
        (request.resource.data.keys().hasAny(['creditsHistory', 'totalCredits']) &&
         (!('totalCredits' in request.resource.data) || 
          request.resource.data.totalCredits <= resource.data.totalCredits));
      
      // ✅ Allow signup process to award referral credits
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'creditsHistory', 
        'totalCredits', 
        'totalReferrals',
        'aiPromptsToday',      // ✅ ADD
        'aiPromptsResetAt'     // ✅ ADD
      ]);

      // ✅ Allow admins to update anything including isAmbassador
      allow update: if isAdmin();
      
      // ✅ Only admins can delete users
      allow delete: if isAdmin();
      
      // ✅ SAVED EVENTS SUB-COLLECTION
      match /savedEvents/{eventId} {
        allow read, write: if isOwner(userId) && isActive();
      }
    }
    
    
    // ==========================================
    // EVENTS COLLECTION
    // ==========================================
    match /events/{eventId} {
      // ✅ Anyone can read individual events (public)
      allow get: if true;
      
      // ✅ Anyone can list/query events (needed for manageKey lookup)
      allow list: if true;
      
      // ✅ Active users, organizers, and campus ambassadors can create events
      allow create: if isActive() || isOrganizer() || isCampusAmbassador();
      
      // ✅ Admin can always update/delete
      // ✅ Event creator can update/delete their own events
      // ✅ Organizers can update/delete their own events
      // ✅ Campus ambassadors can update/delete (scoped to their campus in the app)
      allow update, delete: if isAdmin() || 
        (isActive() && isOwner(resource.data.createdBy)) ||
        (isOrganizer() && isOwner(resource.data.createdBy)) ||
        isCampusAmbassador();
      
      // ✅ Allow webhook to update ticket fields
      // ✅ UPDATED — also allow vendorStands + vendorStandsEnabled, needed by
      // VendorStandsManager.jsx (ManageEvent is manageKey-gated, not auth-gated,
      // so this stays a field-level allow rather than an isOwner() check)
      allow update: if request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['ticketsSold', 'ticketsAvailable', 'ticketTiers', 'vendorStands', 'vendorStandsEnabled']);
}
    
    
    // ==========================================
    // TICKETS COLLECTION - FOR WEBHOOK & MANAGE PAGE
    // ==========================================
    match /tickets/{ticketId} {
      // ✅ Anyone can read tickets (needed for manage page)
      allow read: if true;
      
      // ✅ Anyone can list/query tickets (needed for manage page to query by eventId)
      allow list: if true;
      
      // ✅ Allow webhook to create tickets (unauthenticated)
      allow create: if true;
      
      // ✅ Allow anyone to update tickets (needed for manage page check-in)
      allow update: if true;
      
      // ✅ Only admins can delete tickets
      allow delete: if isAdmin();
    }
    
    
    // ==========================================
    // EVENT SUBMISSIONS COLLECTION - WITH REFERRAL SUPPORT
    // ==========================================
    match /event_submissions/{submissionId} {
  // ✅ Anyone can submit events (even unauthenticated for public form)
  allow create: if true;
  // ✅ Admins and campus ambassadors can read submissions
  // ✅ Anyone can read their own submission (if they have userId)
  allow read: if isAdmin() || isCampusAmbassador() ||
    (isAuthenticated() && resource.data.userId == request.auth.uid);
  // ✅ Admins and campus ambassadors can list submissions (for dashboards)
  // ✅ NEW — a user can also query/list their OWN submissions (needed for
  // OSBOrganizerHome's pending/rejected visibility — this is a list
  // operation, not a single-doc read, so it needed its own exception too)
  allow list: if isAdmin() || isCampusAmbassador() ||
    (isAuthenticated() && resource.data.userId == request.auth.uid);
  // ✅ Admins and campus ambassadors can update (accept/reject)
  allow update: if isAdmin() || isCampusAmbassador();
  // ✅ NEW — the submitter can delete their own submission (pending,
  // rejected, or approved — matches the "you can always delete your own
  // stuff" pattern already used for event_plans above)
  allow delete: if isAdmin() ||
    (isAuthenticated() && resource.data.userId == request.auth.uid);
}
    
    
    // ==========================================
    // CATEGORIES COLLECTION
    // ==========================================
    match /categories/{categoryId} {
      // ✅ Anyone can read categories
      allow read: if true;
      
      // ✅ Only admins can create/update/delete categories
      allow write: if isAdmin();
    }
    
    
    // ==========================================
    // UNIVERSITIES COLLECTION
    // ==========================================
    match /universities/{universityId} {
      // ✅ Anyone can read universities (for public event browsing)
      allow read: if true;
      
      // ✅ Only admins can create/update/delete universities
      allow write: if isAdmin();
    }
    
    
    // ==========================================
    // NOTIFICATIONS COLLECTION
    // ==========================================
    match /notifications/{notificationId} {
      // ✅ Users can only read their own notifications
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // ✅ Users can update (mark as read) their own notifications
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      
      // ✅ Users can delete their own notifications
      // ✅ Admins can delete any notification
      // ✅ Campus ambassadors can delete their campus broadcasts
      allow delete: if isAdmin() || 
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        isCampusAmbassador();
      
      // ✅ Admins can create notifications for users
      // ✅ System can create welcome notifications during signup
      // ✅ Campus ambassadors can broadcast to their campus followers
      allow create: if isAuthenticated();
    }
    
    
    // ==========================================
    // ANALYTICS COLLECTION
    // ==========================================
    match /analytics/{analyticsId} {
      // ✅ Only admins can read analytics
      allow read: if isAdmin();
      
      // ✅ System can write analytics (for tracking)
      allow create: if isAuthenticated();
      
      // ✅ Only admins can update/delete analytics
      allow update, delete: if isAdmin();
    }
    
    
    // ==========================================
    // REPORTED CONTENT COLLECTION
    // ==========================================
    match /reported_content/{reportId} {
      // ✅ Only admins can read reports
      allow read: if isAdmin();
      
      // ✅ Authenticated users can report content
      allow create: if isAuthenticated();
      
      // ✅ Only admins can update/delete reports
      allow update, delete: if isAdmin();
    }
    
    
    // ==========================================
    // FEEDBACK COLLECTION
    // ==========================================
    match /feedback/{feedbackId} {
      // ✅ Users can read their own feedback
      allow read: if isAuthenticated() && 
        (isAdmin() || resource.data.userId == request.auth.uid);
      
      // ✅ Authenticated users can submit feedback
      allow create: if isAuthenticated();
      
      // ✅ Only admins can update/delete feedback
      allow update, delete: if isAdmin();
    }
    
    
    // ==========================================
    // ADMIN LOGS COLLECTION
    // ==========================================
    match /admin_logs/{logId} {
      // ✅ Only admins can read logs
      allow read: if isAdmin();
      
      // ✅ System can write logs
      allow create: if isAdmin();
      
      // ✅ Logs cannot be updated or deleted (immutable audit trail)
      allow update, delete: if false;
    }


    // ==========================================
    // EARLY ACCESS COLLECTION
    // ==========================================
    match /earlyAccess/{docId} {
      // ✅ Anyone can submit their email (unauthenticated)
      allow create: if true;
      
      // ✅ Only admins can read and list
      allow read, list: if isAdmin();
      
      // ✅ Only admins can update (mark as notified)
      allow update: if isAdmin();
      
      // ✅ Only admins can delete
      allow delete: if isAdmin();
    }



// ==========================================
    // VENDORS COLLECTION ✅ NEW
    // ==========================================
    match /vendors/{vendorId} {
      // ✅ Anyone can read vendors (public — students browse vendors)
      allow read: if true;
      allow list: if true;

      // ✅ Admins and campus ambassadors can create/update/delete vendors
      allow create: if isAdmin() || isCampusAmbassador();
      allow update: if isAdmin() || isCampusAmbassador() ||
    // ✅ NEW — the vendor themself can self-edit category, WhatsApp
    // number, and photos on their OWN live listing. vendors docs don't
    // have an ownerId field — they're matched by submittedBy (email),
    // set at approval time — so ownership is checked against the
    // requester's own auth token email instead of uid.
    (isAuthenticated() &&
     resource.data.submittedBy == request.auth.token.email &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category', 'whatsappNumber', 'imageUrl', 'images']));
      allow delete: if isAdmin() || isCampusAmbassador();
    }


    // ==========================================
    // VENDOR SUBMISSIONS COLLECTION ✅ NEW
    // ==========================================
    match /vendor_submissions/{submissionId} {
      // ✅ Anyone can submit (public form — unauthenticated vendors)
      allow create: if true;

      // ✅ Admins and campus ambassadors can read and review submissions
      allow read: if resource.data.status == 'approved' || isAdmin() || isCampusAmbassador();
  allow list: if true;
  allow update: if isAdmin() || isCampusAmbassador() ||
    // ✅ NEW — let a logged-in user "claim" an unowned submission as their own
    // (for CampusVendorPage.jsx's claim-by-phone flow). Only ownerId may change,
    // only from empty/null, and only to the requester's own uid — nothing else
    // on the submission can be touched this way.
    (isAuthenticated() &&
     (!('ownerId' in resource.data) || resource.data.ownerId == null) &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId']) &&
     request.resource.data.ownerId == request.auth.uid) ||
    // ✅ NEW — the owner of a claimed shop can self-edit category, WhatsApp
    // number, and photos (CampusVendorPage.jsx edit mode). Anytime, not just
    // once approved — editing your own pending submission is fine too.
    (isAuthenticated() && resource.data.ownerId == request.auth.uid &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category', 'whatsappNumber', 'imageUrl', 'images']));
  allow delete: if isAdmin();
}
// ==========================================
// VENDOR REPORTS COLLECTION ✅ NEW
// ==========================================
match /vendor_reports/{reportId} {
  // ✅ Anyone can submit a report
  allow create: if true;

  // ✅ Only admins can read and manage
  allow read: if isAdmin();
  allow list: if isAdmin();
  allow update: if isAdmin();
  allow delete: if isAdmin();
}

match /vendor_likes/{likeId} {
  allow read, write: if request.auth != null;
}

// ==========================================
// CREDIT UNLOCK REQUESTS COLLECTION
// ==========================================
match /creditUnlockRequests/{requestId} {
  // ✅ Authenticated users can submit their own request
  allow create: if isAuthenticated() &&
    request.resource.data.userId == request.auth.uid;

  // ✅ Users can read their own requests
  allow read: if isAuthenticated() &&
    resource.data.userId == request.auth.uid;

  // ✅ Admins can read, list, update all requests
  allow read, list: if isAdmin();
  allow update: if isAdmin();
  allow delete: if isAdmin();
}


// ==========================================
// AMBASSADOR EARNINGS COLLECTION
// ==========================================
match /ambassadorEarnings/{docId} {
  // Ambassadors can read their own earnings
  allow read: if isAuthenticated() && request.auth.uid == docId;

  // Webhook can create/update (unauthenticated)
  allow create, update: if true;

  // Admins can read and manage all
  allow read, list: if isAdmin();
  allow delete: if isAdmin();
}

// ==========================================
// AMBASSADOR PAYOUT REQUESTS COLLECTION
// ==========================================
match /ambassadorPayoutRequests/{docId} {
  // Ambassadors can create payout requests
  allow create: if isAuthenticated();

  // Ambassadors can read their own requests
  allow read: if isAuthenticated() &&
    resource.data.ambassadorId == request.auth.uid;

  // Admins can read, list and update all requests
  allow read, list: if isAdmin();
  allow update: if isAdmin();
  allow delete: if isAdmin();
}

// ==========================================
// AMBASSADOR APPLICATIONS COLLECTION (UPDATED)
// ==========================================
match /ambassadorApplications/{docId} {
  allow create: if true;
  // ✅ FIXED — read only covered single-doc fetches, not the queries
  // both My Roles and the Ambassador screen actually run. Added list,
  // scoped the same way as read (own applications only).
  allow read, list: if isAdmin() ||
    (isAuthenticated() && resource.data.accountEmail == request.auth.token.email);
  allow update, delete: if isAdmin();
}

// ==========================================
// ESSENTIAL SERVICES COLLECTION
// ==========================================
match /essential_services/{serviceId} {
  // ✅ Public read — every user needs access to emergency contacts,
  // logged in or not, no exceptions.
  allow read: if true;
  // ✅ Admin-only write — accuracy here is a genuine safety concern,
  // matches the admin-curated decision made when this was designed.
  allow create, update, delete: if isAdmin();
}


// ==========================================
// BUSINESSES COLLECTION ✅ NEW (Become a Business / OSB)
// ==========================================
match /businesses/{businessId} {
  // ✅ Anyone can read an approved business (future public directory);
  // an owner can also read their own regardless of status; admin sees all
  allow read: if resource.data.status == 'approved' || isAdmin() ||
    (isAuthenticated() && resource.data.ownerId == request.auth.uid);
  allow list: if true;
  // ✅ A logged-in user can submit their own business
  allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
  // ✅ Owner can self-edit; admin manages status/approval
  allow update: if isAdmin() ||
    (isAuthenticated() && resource.data.ownerId == request.auth.uid &&
     resource.data.status == 'approved' &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pricingTiers', 'hourlyPackages'])) ||
    // ✅ UPDATED — businessName removed from here. Name changes now go
    // through the separate pending-request clause below.
    (isAuthenticated() && resource.data.ownerId == request.auth.uid &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(
       ['description', 'city', 'area', 'whatsappNumber', 'pricingInfo', 'logoUrl']
     )) ||
    // ✅ owner can submit a Gov ID for verification, but only ever to
    // 'pending'. Flipping it to 'approved' requires isAdmin(), covered by
    // the first clause above — the owner can never self-approve.
    (isAuthenticated() && resource.data.ownerId == request.auth.uid &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['govIdUrl', 'govIdStatus']) &&
     request.resource.data.govIdStatus == 'pending') ||
    // ✅ same for CAC
    (isAuthenticated() && resource.data.ownerId == request.auth.uid &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cacUrl', 'cacStatus']) &&
     request.resource.data.cacStatus == 'pending') ||
    // ✅ owner can resubmit after a rejection. Only rejected→pending,
    // touching status alone — never straight to 'approved', which stays
    // admin-only via the isAdmin() clause at the top of this rule.
    (isAuthenticated() && resource.data.ownerId == request.auth.uid &&
     resource.data.status == 'rejected' &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
     request.resource.data.status == 'pending') ||
    // ✅ NEW — owner can request a business name change, but ONLY if not
    // CAC-verified (green or gold tick both require cacStatus ==
    // 'approved' — this single check correctly excludes both while still
    // allowing a blue-tick-only business to request a change). Lands in
    // a pending field; a scheduled Cloud Function applies it 30 days later.
    (isAuthenticated() && resource.data.ownerId == request.auth.uid &&
     resource.data.cacStatus != 'approved' &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingBusinessName', 'pendingBusinessNameRequestedAt']));
  allow delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
}

// ==========================================
// EVENT PLANS COLLECTION ✅ NEW (Plan My Event wizard)
// ==========================================
match /event_plans/{planId} {
  // ✅ A logged-in user can submit their own plan
  allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

  // ✅ A user can read their own plan; admin manually matches vendors for now
  allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
  allow read, list: if isAdmin();
  allow update: if isAdmin();
  // ✅ NEW — owner can delete their own plan (My Events "Delete" button)
  allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
}

// ==========================================
// VEHICLES COLLECTION ✅ NEW (Rent a Ride)
// ==========================================
match /vehicles/{vehicleId} {
  // ✅ Anyone can browse listed vehicles
  allow read, list: if true;

  // ✅ Admin-only write until OSB vendor accounts exist to own these
  allow create, update, delete: if isAdmin();
}

// ==========================================
// STAND APPLICATIONS COLLECTION ✅ NEW (Vendor Stands marketplace)
// ==========================================
match /standApplications/{applicationId} {
  // ✅ Mirrors the 'tickets' pattern deliberately: ManageEvent is
  // manageKey-gated, not Firebase-Auth-gated, so organizer approve/reject
  // actions on that page can't rely on isOwner() checks. Same open model
  // as 'tickets' above, not a new risk being introduced here.
  allow read, list: if true;
  allow create: if true;   // webhook writes these, unauthenticated
  allow update: if true;   // organizer approve/reject from the un-authed manage page
  allow delete: if isAdmin();
}

// ==========================================
// SERVICE REQUESTS COLLECTION ✅ NEW (Plan Event hybrid choose-or-request)
// ==========================================
match /serviceRequests/{requestId} {
  // ✅ Planner creates their own request
  allow create: if isAuthenticated() && request.resource.data.plannerUserId == request.auth.uid;

  // ✅ Planner reads their own; approved businesses can browse open requests
  // matching their category — the app filters by businessType/city client-side,
  // this just needs to allow read broadly like other open-marketplace collections
  allow read, list: if true;

  // ✅ Planner can close/cancel their own; a business can accept an open one
  // (first to accept wins — enforced by only allowing the transition from
  // 'open' to 'accepted', not overwriting an already-accepted request)
  allow update: if isAdmin() ||
    (isAuthenticated() && resource.data.plannerUserId == request.auth.uid) ||
    (isAuthenticated() && resource.data.status == 'open' &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedByBusinessId', 'acceptedByBusinessName']) &&
     request.resource.data.status == 'accepted') ||
    // ✅ NEW — lets the target business respond to a DIRECT request sent
    // straight to them (Accept/Decline). Verified via a get() lookup that
    // the requester actually owns the business the request was sent to.
    (isAuthenticated() && resource.data.status == 'pending' && resource.data.requestType == 'direct' &&
     exists(/databases/$(database)/documents/businesses/$(resource.data.targetBusinessId)) &&
     get(/databases/$(database)/documents/businesses/$(resource.data.targetBusinessId)).data.ownerId == request.auth.uid &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
     (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined'));
  allow delete: if isAdmin() || (isAuthenticated() && resource.data.plannerUserId == request.auth.uid);
}

// ==========================================
// PLACE CLAIMS COLLECTION ✅ NEW (Hall/Resort/Restaurant ownership claims)
// ==========================================
match /placeClaims/{claimId} {
  allow create: if isAuthenticated() && request.resource.data.claimantUid == request.auth.uid;
  allow read: if isAdmin() || (isAuthenticated() && resource.data.claimantUid == request.auth.uid);
  allow list: if isAdmin();
  allow update: if isAdmin();
  allow delete: if isAdmin();
}

// ==========================================
// APP CONFIG COLLECTION (force-update check)
// ==========================================
match /app_config/{docId} {
  // ✅ Public read — every user's app needs to check this on launch,
  // logged in or not.
  allow read: if true;
  // ✅ Admin-only write — this controls what version gets force-blocked.
  allow write: if isAdmin();
}



// ==========================================
// SERVICE QUOTES COLLECTION ✅ NEW (Open Offers → businesses submit quotes)
// ==========================================
match /serviceQuotes/{quoteId} {
  // ✅ A business submits its own quote against an open offer
  allow create: if isAuthenticated();

  // ✅ Businesses read their own quotes; planners read quotes on their requests
  // — kept open-read like the other marketplace collections above, since this
  // mirrors the same trust model as serviceRequests/standApplications
  allow read, list: if true;

  // ✅ Planner accepts/declines a quote; business can withdraw their own;
  // planner can also delete quotes tied to their own requests (needed when
  // they delete the whole plan, so quotes don't become orphaned)
  allow update: if isAuthenticated();
  allow delete: if isAdmin() || (isAuthenticated() && resource.data.plannerUserId == request.auth.uid);
}

    // ==========================================
    // OUTINGS
    // ==========================================
    match /outings/{outingId} {
  allow read: if true;
  allow create: if isOwner(request.resource.data.posterId);
  allow update: if isOwner(resource.data.posterId)
                || isAdmin()
                || request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['likeCount', 'commentCount', 'viewCount']);
  allow delete: if isOwner(resource.data.posterId) || isAdmin(); // ✅ NEW — lets the admin panel cascade-delete a business's Outings

  match /likes/{userId} {
    allow read: if true;
    allow write: if isOwner(userId) || isAdmin(); // ✅ NEW — admin cleanup access
  }

  match /comments/{commentId} {
    allow read: if true;
    allow create: if isOwner(request.resource.data.userId);
    allow delete: if isOwner(resource.data.userId) || isAdmin(); // ✅ NEW — admin cleanup access
  }
}

// ==========================================
    // MUSIC TRACKS (Outings background music library)
    // ==========================================
    match /musicTracks/{trackId} {
  allow read: if true;
  allow create, update, delete: if isAdmin();
}

// ==========================================
// USER AUDIO TRACKS (user-imported audio for outings)
// ==========================================
match /userAudioTracks/{trackId} {
  // Reads are open — these tracks can be attached to public Outings, so
  // anyone viewing the feed needs to fetch the audioUrl to play it, not
  // just the track's owner. Title + audio URL isn't sensitive data.
  allow read: if true;
  allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
  allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
}
    // ==========================================
    // BLOCK ALL OTHER COLLECTIONS
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
