{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/e/(.*)",
      "destination": "https://og-vawapehfla-uc.a.run.app/e/$1"
    },
    {
      "source": "/s/(.*)",
      "destination": "/api/og/shortlet/$1"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/og/ride/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/rollover-ambassador-cycles",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/refund?cron=1",
      "schedule": "0 6 * * *"
    }
  ]
}